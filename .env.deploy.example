# Deployment template — copy to .env.deploy and `source` (or `set -a`-export)
# before running ./bin/up.sh on a remote host.
#
# How this maps to nginx routing
# ──────────────────────────────────────────────────────────────────────────
#   docker-compose.proxy.yml + nginx/nginx.conf put a single nginx in front
#   of every service. Each backend gets its own URL prefix; nginx strips the
#   prefix on the way through (`proxy_pass http://upstream/`):
#
#       /usermgmt/ → brainkb-unified:8004 (auth, users, admin, RBAC)
#       /ml/       → brainkb-unified:8007 (SynthScholar, NER, struct.res)
#       /qry/      → brainkb-unified:8010 (SPARQL, KG ingest)
#       /chat-svc/ → brainkb-chat:8011    (optional)
#       /          → web:3000             (this Next.js UI)
#
# So every URL below is just `https://<your-host>/<service-prefix>/api/...`.
# Replace `app.example.com` with your real public hostname.

# ── Public origin ─────────────────────────────────────────────────────────
# Where users hit the deployment. Used by NextAuth for OAuth callback URLs;
# must match the OAuth redirect URIs you registered with each provider.
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ── Host port mapping ─────────────────────────────────────────────────────
# Port the host binds for the nginx proxy. Behind an ALB you'd typically
# leave this at 80 and let the ALB terminate TLS.
PROXY_HOST_PORT=80
# Useful when running without the proxy overlay; nginx isn't in the picture
# so the UI is reached directly.
WEB_HOST_PORT=3000

# ── User management ───────────────────────────────────────────────────────
NEXT_PUBLIC_USER_MANAGEMENT_API_BASE=https://app.example.com/usermgmt
NEXT_PUBLIC_TOKEN_ENDPOINT_USER_MANAGEMENT_SERVICE=https://app.example.com/usermgmt/api/token
NEXT_PUBLIC_CREATE_USER_PROFILE_ENDPOINT_USER_MANAGEMENT_SERVICE=https://app.example.com/usermgmt/api/users/profile
NEXT_PUBLIC_GET_ENDPOINT_USER_PROFILE_USER_MANAGEMENT_SERVICE=https://app.example.com/usermgmt/api/users/profile
NEXT_PUBLIC_UPDATE_ENDPOINT_USER_PROFILE_USER_MANAGEMENT_SERVICE=https://app.example.com/usermgmt/api/users/profile
NEXT_PUBLIC_GET_ENDPOINT_USER_ACTIVITY_USER_MANAGEMENT_SERVICE=https://app.example.com/usermgmt/api/users/activities
NEXT_PUBLIC_ENABLE_PAGE_ACCESS_GATE=true

# ── ML service (SynthScholar, NER, structured resources) ──────────────────
NEXT_PUBLIC_ML_SERVICE_API_BASE=https://app.example.com/ml
NEXT_PUBLIC_TOKEN_ENDPOINT_ML_SERVICE=https://app.example.com/ml/api/token

# WebSockets — note the wss:// scheme behind TLS.
NEXT_PUBLIC_API_NER_ENDPOINT=wss://app.example.com/ml/api/ws/ner
NEXT_PUBLIC_API_PDF2REPROSCHEMA_ENDPOINT=wss://app.example.com/ml/api/ws/pdf2reproschema
NEXT_PUBLIC_API_ADMIN_EXTRACT_STRUCTURED_RESOURCE_ENDPOINT=wss://app.example.com/ml/api/ws/extract-resources

NEXT_PUBLIC_NER_GET_ENDPOINT=https://app.example.com/ml/api/ner
NEXT_PUBLIC_NER_SAVE_ENDPOINT=https://app.example.com/ml/api/save/ner
NEXT_PUBLIC_API_ADMIN_SAVE_STRUCTURED_RESOURCE_ENDPOINT=https://app.example.com/ml/api/save/structured-resource
NEXT_PUBLIC_API_ADMIN_GET_STRUCTURED_RESOURCE_ENDPOINT=https://app.example.com/ml/api/structured-resource

# ── Query service (SPARQL + KG ingest) ────────────────────────────────────
NEXT_PUBLIC_TOKEN_ENDPOINT_QUERY_SERVICE=https://app.example.com/qry/api/token
NEXT_PUBLIC_API_QUERY_ENDPOINT=https://app.example.com/qry/api/query/sparql/
NEXT_PUBLIC_API_NAMED_GRAPH_QUERY_ENDPOINT=https://app.example.com/qry/api/query/registered-named-graphs
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_ENDPOINT=https://app.example.com/qry/api/insert/files/knowledge-graph-triples
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=https://app.example.com/qry/api/insert/jobs
NEXT_PUBLIC_API_ADMIN_INSERT_ALL_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=https://app.example.com/qry/api/insert/user/jobs/detail
NEXT_PUBLIC_API_ADMIN_INSERT_RECOVERY_JOB_ENDPOINT=https://app.example.com/qry/api/insert/jobs/recover
NEXT_PUBLIC_API_ADMIN_INSERT_CHECK_RECOVERABLE_JOB_ENDPOINT=https://app.example.com/qry/api/insert/jobs/check-recoverable

# ── Chat service (optional) ───────────────────────────────────────────────
NEXT_PUBLIC_TOKEN_ENDPOINT_CHAT_SERVICE=https://app.example.com/chat-svc/api/token
NEXT_PUBLIC_CHAT_SERVICE_API_ENDPOINT=https://app.example.com/chat-svc/api/chat?stream=false

# ── Service-account JWT (used by the UI to call backend APIs) ─────────────
# These are sent in `Authorization: Bearer …` from the UI to backend services
# and are NOT exposed to end-user browsers — but they ARE inlined by Next.js.
# Treat the deployment as if the values are public; rotate on the backend if
# leaked.
NEXT_PUBLIC_JWT_USER=service@example.com
NEXT_PUBLIC_JWT_PASSWORD=replace-with-a-strong-secret

# ── Misc ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_IPIFY_KEY=
