# brainkb-ui configuration. Copy to .env.local (git-ignored) and fill in.
#
# Generated from the code, not from memory: every variable below is read somewhere in
# this repo, and every variable the code reads appears here. The typed registry in
# src/config/env.ts is the source of truth for the NEXT_PUBLIC_* set — if you add one
# there, add it here too.
#
# Two rules worth knowing before editing:
#   * Only NEXT_PUBLIC_* reaches the browser. Anything else (NER_API_KEY,
#     NEXTAUTH_SECRET, USER_MANAGEMENT_API_BASE) is server-only and must never be
#     renamed into the NEXT_PUBLIC_ namespace — that would ship it to every visitor.
#   * No trailing `# comment` after a value: most loaders keep it as part of the value.

# Local service ports, for orientation:
#   8004  usermanagement_service      8010  query_service
#   8007  ml_service (structsense, SynthScholar, NER, pdf2reproschema)
#   8011  chat service
#
# Note the convention: NEXT_PUBLIC_API_ADMIN_HOST is a bare host, but every
# NEXT_PUBLIC_API_*_ENDPOINT is a FULL URL. src/services/query-service/apiService.ts
# uses the endpoint verbatim (`${endpoint}?${params}`) and does not join it to the
# host, so a relative path like 'query/sparql' fails to resolve. Some API routes carry
# a `|| "query/sparql"` fallback that would be broken if it ever fired; it does not,
# because the variable is always set.

# ---------------------------------------------------------------------------------
# Required — the app does not work without these
# ---------------------------------------------------------------------------------

# query_service host. The only NEXT_PUBLIC_API_* with a built-in default
# (https://queryservice.brainkb.org), so an unset value silently talks to production.
NEXT_PUBLIC_API_ADMIN_HOST=http://127.0.0.1:8010

# SPARQL endpoint, full URL.
NEXT_PUBLIC_API_QUERY_ENDPOINT=http://127.0.0.1:8010/api/query/sparql/

# NextAuth session signing. Any long random string; `openssl rand -base64 32`.
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Canonical URL of this UI. NextAuth reads it directly from the environment.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------------
# Auth / user management
# ---------------------------------------------------------------------------------

# usermanagement_service, browser-visible base. Powers the admin dashboard,
# /api/auth/providers (which sign-in buttons to render), /api/users/me, and the
# page-access checks at /api/access/page/<page_key>. Falls back to
# http://localhost:8004 in dev if unset.
NEXT_PUBLIC_USER_MANAGEMENT_API_BASE=http://127.0.0.1:8004

# The same service as seen by the SERVER (lib/auth.ts). Keep it separate from the
# public one: inside Docker the server reaches it over the internal network while the
# browser needs the published host.
USER_MANAGEMENT_API_BASE=http://127.0.0.1:8004

# Token exchange endpoints, one per backend audience.
NEXT_PUBLIC_TOKEN_ENDPOINT_USER_MANAGEMENT_SERVICE=http://127.0.0.1:8004/api/token
NEXT_PUBLIC_TOKEN_ENDPOINT_QUERY_SERVICE=http://127.0.0.1:8010/api/token
NEXT_PUBLIC_TOKEN_ENDPOINT_ML_SERVICE=http://127.0.0.1:8007/api/token
NEXT_PUBLIC_TOKEN_ENDPOINT=http://127.0.0.1:8010/api/token

# Service-account login used by scripts/warm-cache.mjs and the assistant client for
# unauthenticated reads. Leave unset in any deployment where every read should carry a
# real user's identity.
# NEXT_PUBLIC_JWT_USER=
# NEXT_PUBLIC_JWT_PASSWORD=

# Send 'Authorization: Bearer' instead of the legacy scheme. 'true' to enable.
NEXT_PUBLIC_USE_BEARER_TOKEN=true

# OAuth provider credentials (GitHub / ORCID / Globus) are NOT read here — they live in
# usermanagement_service's own .env. This UI asks the backend which providers are
# configured and renders only those buttons.

# ---------------------------------------------------------------------------------
# Knowledge-graph queries and ingest (query_service)
# ---------------------------------------------------------------------------------

# Named-graph registry query, used by the knowledge-base pages.
NEXT_PUBLIC_API_NAMED_GRAPH_QUERY_ENDPOINT=http://127.0.0.1:8010/api/query/registered-named-graphs

# Taxonomy query behind /hmba-taxonomy.
NEXT_PUBLIC_API_QUERY_TAXONOMY_ENDPOINT=http://127.0.0.1:8010/api/query/taxonomy

# Ingest (/user/ingest-kg) and its job polling (/user/job-status).
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_ENDPOINT=http://127.0.0.1:8010/api/insert/files/knowledge-graph-triples
NEXT_PUBLIC_API_ADMIN_INSERT_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=http://127.0.0.1:8010/api/insert/jobs
NEXT_PUBLIC_API_ADMIN_INSERT_ALL_KGS_JSONLD_TTL_JOB_STATUS_ENDPOINT=http://127.0.0.1:8010/api/insert/user/jobs/detail

# Stuck-job recovery, surfaced on the job-status page.
NEXT_PUBLIC_API_ADMIN_INSERT_CHECK_RECOVERABLE_JOB_ENDPOINT=http://127.0.0.1:8010/api/insert/jobs/check-recoverable
NEXT_PUBLIC_API_ADMIN_INSERT_RECOVERY_JOB_ENDPOINT=http://127.0.0.1:8010/api/insert/jobs/recover

# ---------------------------------------------------------------------------------
# Extraction services (NER, structured resources, SynthScholar, structsense)
# ---------------------------------------------------------------------------------

# NER: run (websocket), fetch, save. /user/sie and the admin review screens.
NEXT_PUBLIC_API_NER_ENDPOINT=ws://127.0.0.1:8007/api/ws/ner
NEXT_PUBLIC_NER_GET_ENDPOINT=http://127.0.0.1:8007/api/ner
NEXT_PUBLIC_NER_SAVE_ENDPOINT=http://127.0.0.1:8007/api/save/ner
NEXT_PUBLIC_API_ADMIN_GET_NER_ENDPOINT=http://127.0.0.1:8007/api/ner

# Server-only key for the NER service. Never rename this into NEXT_PUBLIC_*.
NER_API_KEY=

# Structured-resource extraction (tools/datasets/models out of papers).
NEXT_PUBLIC_API_ADMIN_EXTRACT_STRUCTURED_RESOURCE_ENDPOINT=ws://127.0.0.1:8007/api/ws/extract-resources
NEXT_PUBLIC_API_ADMIN_GET_STRUCTURED_RESOURCE_ENDPOINT=http://127.0.0.1:8007/api/structured-resource
NEXT_PUBLIC_API_ADMIN_SAVE_STRUCTURED_RESOURCE_ENDPOINT=http://127.0.0.1:8007/api/save/structured-resource

# structsense (schema-directed extraction) and PDF -> ReproSchema.
NEXT_PUBLIC_STRUCTSENSE_ENDPOINT=ws://127.0.0.1:8007/api/ws/structsense
NEXT_PUBLIC_API_PDF2REPROSCHEMA_ENDPOINT=ws://127.0.0.1:8007/api/ws/pdf2reproschema

# ml_service base — SynthScholar systematic reviews (/user/synth-scholar). The router
# lives under /api/synth-scholar, mounted alongside structsense, and serves: starting
# reviews, polling status, live progress over SSE, plan-confirmation gating, exports
# (markdown/JSON/BibTeX/RDF), and visibility/cache-sharing toggles.
#
# Auth: every call carries a Bearer token from /api/token using the JWT credentials
# above. SSE passes the same token as `?token=` because EventSource cannot send
# headers.
#
# The OpenRouter key is NOT configured here: the page resolves the user's personal key
# from sessionStorage (dashboard -> "API key" tab) or the admin-shared key managed in
# /admin, and forwards it per request. ml_service's own env var is an operator
# fallback only.
NEXT_PUBLIC_ML_SERVICE_API_BASE=http://127.0.0.1:8007

# ---------------------------------------------------------------------------------
# Assistant (chat)
# ---------------------------------------------------------------------------------

# Browser-visible chat endpoint, and the server-side one the API route proxies to.
NEXT_PUBLIC_CHAT_ENDPOINT=http://127.0.0.1:8011/api/chat?stream=false
NEXT_PUBLIC_CHAT_SERVICE_API_ENDPOINT=http://127.0.0.1:8011/api/chat?stream=false
CHAT_SERVICE_API_ENDPOINT=http://127.0.0.1:8011/api/chat?stream=false

# ---------------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------------

# Absolute base this app uses when calling its own /api routes from the server.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Per-page access gating (src/config/featureFlags.ts). ON unless set to exactly
# 'false' — any other value, including empty, leaves it enabled.
NEXT_PUBLIC_ENABLE_PAGE_ACCESS_GATE=true
